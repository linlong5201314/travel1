{
  "name": "global-travel-blog",
  "version": "1.0.0",
  "description": "环球旅记 - Global Travel Blog",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "fast-check": "^3.15.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "moduleFileExtensions": [
      "js"
    ],
    "verbose": true,
    "collectCoverageFrom": [
      "static/js/**/*.js"
    ]
  }
}
